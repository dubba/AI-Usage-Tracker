{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "api-integration",
  "description": "The Paseo Bridge window: it can only read bridge info, manage the bridge token, and follow the app theme",
  "windows": ["api-integration"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "allow-get-bridge-info",
    "allow-reveal-bridge-token",
    "allow-regenerate-bridge-token"
  ]
}
