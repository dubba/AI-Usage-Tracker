{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the AI Usage Tracker desktop windows",
  "windows": ["main", "paseo-bridge"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://auth.openai.com/*" },
        { "url": "https://claude.ai/*" },
        { "url": "https://accounts.google.com/*" },
        { "url": "https://github.com/yajinni/AI-Usage-Tracker/blob/main/CHANGELOG.md" }
      ]
    },
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "window-state:default"
  ]
}
