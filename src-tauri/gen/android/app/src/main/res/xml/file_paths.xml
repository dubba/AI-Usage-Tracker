<?xml version="1.0" encoding="utf-8"?>
<!--
  Only what the FileProvider hands to other apps: the downloaded update APK and
  camera captures. Never widen these to "." - the app's files directory holds
  the credential files and account data.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <cache-path name="update_apk_cache" path="updates/" />
  <files-path name="update_apk" path="updates/" />
  <external-files-path name="camera_pictures" path="Pictures/" />
</paths>
