<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>AI Usage Tracker uses the local network to pair devices and transfer accounts.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_aiut-pair._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>AI Usage Tracker requires camera access to scan device linking QR codes.</string>
	<!-- Refresh usage while the app is closed (platform/ios_background.rs). The identifier
	     must match TASK_IDENTIFIER there. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.dubba.ai.usage.tracker.refresh</string>
	</array>
	<!-- Sync Devices transfer files (.aiutpair, the same type as Android's
	     TransferFiles.MIME_TYPE). Declaring the type lets AirDrop, Files and Mail offer this app
	     for one; platform/ios_files.rs reads opened URLs with security-scoped access and also
	     watches a user-selected Downloads folder via a persistent security-scoped bookmark. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.dubba.ai.usage.tracker.transfer</string>
			<key>UTTypeDescription</key>
			<string>AI Usage Tracker transfer file</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>aiutpair</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.aiut.pair</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>AI Usage Tracker transfer file</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.dubba.ai.usage.tracker.transfer</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Apps built with the iOS 27 SDK must use the scene life cycle; this key opts tao
	     into it. One window, so a single scene. tao installs its own scene delegate. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
</dict>
</plist>
