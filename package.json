{
  "name": "ai-usage-tracker",
  "private": true,
  "version": "0.3.18",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false && npm run lint",
    "lint": "oxlint src",
    "probe:gemini-quota": "node scripts/gemini-quota-probe.mjs",
    "test:gemini-quota-probe": "node --test scripts/gemini-quota-probe.test.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "android:dev": "JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home tauri android dev",
    "android:build": "JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home tauri android build --target aarch64",
    "update:sidestore": "node scripts/update-sidestore-source.mjs",
    "resolve:version": "node scripts/resolve-release-version.mjs",
    "test:resolve-version": "node --test scripts/resolve-release-version.test.mjs",
    "test:sidestore-source": "node --test scripts/update-sidestore-source.test.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "jsqr": "^1.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^5.0.2"
  }
}
