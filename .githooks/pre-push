#!/usr/bin/env bash
# Runs the CI-equivalent checks on a clean checkout of the commit being pushed, limited to
# the groups the push touches (see scripts/preflight.sh). git passes the refs on stdin.
# Force everything: PREFLIGHT_FULL=1 git push. Bypass for an urgent push: git push --no-verify
set -u
repo=$(git rev-parse --show-toplevel)
exec bash "$repo/scripts/preflight.sh" --pre-push
